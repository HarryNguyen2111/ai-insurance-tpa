{
  "name": "@tpa/core-api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit --incremental false",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "pnpm test:integration && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config test/jest-e2e.json",
    "test:smoke": "node --test test/compiled.smoke.mjs",
    "test:integration": "node --test --test-concurrency=1 --test-timeout=180000 test/identity.pg.test.mjs test/workflow-definitions.pg.test.mjs test/documents.pg.test.mjs test/claims.pg.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1178.0",
    "@aws-sdk/s3-request-presigner": "3.1178.0",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@tpa/database": "workspace:*",
    "@tpa/workflow": "workspace:*",
    "jose": "6.2.18",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.6.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.0.0",
    "jest": "30.5.2",
    "supertest": "^7.0.0",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  }
}
