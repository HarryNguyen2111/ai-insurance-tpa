{
  "name": "tpa",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22.3 <25",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "build": "turbo run build",
    "test:smoke": "turbo run test:smoke",
    "dev": "turbo run dev",
    "preview:local": "turbo run build --filter=@tpa/core-api --filter=@tpa/workbench && pnpm --filter @tpa/workbench preview:local",
    "preview:stop": "pnpm --filter @tpa/workbench preview:stop",
    "infra:up": "docker compose -f infra/compose/compose.yaml up -d --wait --wait-timeout 300",
    "infra:down": "docker compose -f infra/compose/compose.yaml down",
    "infra:smoke": "docker compose -f infra/compose/compose.yaml --profile test run --build --rm smoke",
    "db:migrate": "pnpm --filter @tpa/database migrate",
    "db:generate": "pnpm --filter @tpa/database generate",
    "db:test:integration": "pnpm --filter @tpa/database test:integration"
  },
  "devDependencies": {
    "turbo": "2.11.13"
  }
}
