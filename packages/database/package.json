{
  "name": "@tpa/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test test/config.test.ts test/tenant.test.ts test/audit.test.ts test/idempotency.test.ts test/outbox.test.ts",
    "test:integration": "node --test --test-concurrency=1 --test-timeout=180000 test/*.integration.test.ts",
    "migrate": "node src/cli.ts",
    "generate": "drizzle-kit generate --config drizzle.config.ts"
  },
  "dependencies": {
    "@tpa/event-contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3"
  },
  "exports": {
    "./tenant": "./src/tenant.ts",
    "./audit": "./src/audit.ts",
    "./idempotency": "./src/idempotency.ts",
    "./outbox": "./src/outbox.ts",
    "./migrate": "./src/migrate.ts"
  }
}
