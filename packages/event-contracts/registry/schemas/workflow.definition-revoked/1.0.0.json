{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "tenantId",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "correlationId",
    "causationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "workflow.definition-revoked"
      ]
    },
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changeKind",
        "versionNo",
        "contentHash",
        "reasonCode",
        "suspendedExecutionCount"
      ],
      "properties": {
        "changeKind": {
          "type": "string",
          "enum": [
            "REVOKED"
          ]
        },
        "versionNo": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reasonCode": {
          "type": "string",
          "enum": [
            "DEFECT",
            "POLICY_CHANGE",
            "SECURITY"
          ]
        },
        "suspendedExecutionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    }
  },
  "description": "Internal outbox envelope (VWF-03 #80); aggregateId is the workflowDefinitionId. In-flight executions are suspended, never migrated (VWF-OD-02). Ids/version/hash/codes only. Inbox dedup and aggregate version ordering required.",
  "$schema": "http://json-schema.org/draft-04/schema#"
}
