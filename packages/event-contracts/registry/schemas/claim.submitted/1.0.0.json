{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "tenantId",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "correlationId",
    "causationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "claim.submitted"
      ]
    },
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  },
  "description": "Internal outbox envelope only (spec 06 minimal event), tenantId derived by trusted core. Empty payload: consumers reload the authorized claim by aggregateId. Partition by tenantId:aggregateId; consumer inbox dedup and aggregate version ordering required. No exactly-once promise.",
  "$schema": "http://json-schema.org/draft-04/schema#"
}
