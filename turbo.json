{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "outputs": []
    },
    "test": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test:smoke": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "PORT",
        "HOST"
      ]
    }
  }
}
